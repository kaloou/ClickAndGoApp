@model ClickAndGoApp.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Click & Go - Connexion</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="stylesheet" href="~/css/style.css"/>
</head>
<body class="login-page">

<div class="login-card">
    <a href="/" class="login-back">← Retour</a>

    <h1>Click & Go</h1>
    <p class="subtitle">Connectez-vous à votre compte</p>

    <form method="post" asp-controller="Auth" asp-action="Login">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div asp-validation-summary="All" class="error"></div>
        }

        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" placeholder="votre@email.com"/>
        </div>

        <div class="form-group">
            <label asp-for="Password">Mot de passe</label>
            <input asp-for="Password" placeholder="••••••••" type="password"/>
        </div>

        <button type="submit">Se connecter</button>
    </form>

    <p class="login-register">
        Pas de compte ? <a asp-controller="Auth" asp-action="Register">Créez-en un</a>
    </p>
</div>

@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
</body>
</html>