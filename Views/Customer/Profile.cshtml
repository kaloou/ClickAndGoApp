@model ClickAndGoApp.ViewModels.CustomerAccountViewModel
@{
    ViewData["Title"] = "Mon compte";
}

<div class="browse-page">

    <div class="browse-header">
        <a asp-controller="Home" asp-action="Index" class="detail-back">← Accueil</a>
        <h1>Mon compte</h1>
    </div>

    @* ====== Informations personnelles ====== *@
    <div class="section-card">

        <div class="section-header">
            <h2>Informations personnelles</h2>
        </div>

        <form asp-action="UpdateProfile" method="post" class="section-form">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Prénom</label>
                        <input type="text" name="firstName" value="@Model.Customer.FirstName" required />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Nom</label>
                        <input type="text" name="lastName" value="@Model.Customer.LastName" required />
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label>Email</label>
                <input type="text" value="@Model.Customer.Email" class="input-disabled" disabled />
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Téléphone</label>
                        <input type="number" name="phoneNumber" value="@Model.Customer.PhoneNumber" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Adresse</label>
                        <input type="text" name="address" value="@Model.Customer.Address" />
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label>Mot de passe</label>
                <input type="password" name="password" placeholder="••••••" required />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-cta">Enregistrer</button>
            </div>
        </form>

        <div class="profile-logout">
            <a asp-controller="Auth" asp-action="Logout" class="btn-logout">
                <i data-lucide="log-out"></i>
                Se déconnecter
            </a>
        </div>


    </div>

    @* ====== Historique des commandes ====== *@
    <div class="section-card">

        <div class="section-header">
            <h2>Historique des commandes</h2>
        </div>

        @if (!Model.Orders.Any())
        {
            <div class="no-results">Aucune commande passée.</div>
        }
        else
        {
            foreach (var order in Model.Orders)
            {
                <div class="order-row">
                    <div>
                        <p class="order-row-title">Commande #@order.OrderId</p>
                        <p class="label order-row-meta">
                            @order.OrderDate.ToString("dd/MM/yyyy")
                            @if (order.PickupDate != DateTime.MinValue)
                            {
                                <span> — Retrait : @order.PickupDate.ToString("dd/MM/yyyy HH:mm")</span>
                            }
                        </p>
                    </div>
                    <span class="badge @(order.Status.ToString() == "Honored" ? "badge-honnored" : order.Status.ToString() == "Ready" ? "badge-ready" : "badge-pending")">
                        @order.Status
                    </span>
                </div>
            }
        }

    </div>

</div>
