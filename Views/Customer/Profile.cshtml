@model ClickAndGoApp.ViewModels.CustomerAccountViewModel
@{
    ViewData["Title"] = "Mon compte";
}

<div class="browse-page">

    <div class="browse-header">
        <h1>Mon compte</h1>
    </div>

    @* ====== Informations personnelles ====== *@
    <div class="product-detail-card" style="flex-direction:column; gap:0; padding:0; overflow:hidden; margin-bottom:32px">

        <div style="padding:20px 32px; border-bottom:1px solid var(--border)">
            <h2 style="font-size:1.1rem; font-weight:700; margin:0; color:var(--text-dark)">Informations personnelles</h2>
        </div>

        <form asp-action="UpdateProfile" method="post" style="padding:24px 32px">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Prénom</label>
                        <input type="text" name="firstName" value="@Model.Customer.FirstName" required />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Nom</label>
                        <input type="text" name="lastName" value="@Model.Customer.LastName" required />
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label>Email</label>
                <input type="text" value="@Model.Customer.Email" disabled style="background:#f9f9f9; color:var(--text-gray)" />
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Téléphone</label>
                        <input type="number" name="phoneNumber" value="@Model.Customer.PhoneNumber" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Adresse</label>
                        <input type="text" name="address" value="@Model.Customer.Address" />
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label>Mot de passe</label>
                <input type="password" name="password" placeholder="••••••" required />
            </div>

            <div style="display:flex; justify-content:flex-end">
                <button type="submit" class="btn-cta">Enregistrer</button>
            </div>
        </form>

    </div>

    @* ====== Historique des commandes ====== *@
    <div class="product-detail-card" style="flex-direction:column; gap:0; padding:0; overflow:hidden">

        <div style="padding:20px 32px; border-bottom:1px solid var(--border)">
            <h2 style="font-size:1.1rem; font-weight:700; margin:0; color:var(--text-dark)">Historique des commandes</h2>
        </div>

        @if (!Model.Orders.Any())
        {
            <div class="no-results">Aucune commande passée.</div>
        }
        else
        {
            foreach (var order in Model.Orders)
            {
                <div style="display:flex; align-items:center; justify-content:space-between; padding:20px 32px; border-bottom:1px solid var(--border)">
                    <div>
                        <p style="font-weight:600; margin:0; color:var(--text-dark)">Commande #@order.OrderId</p>
                        <p class="label" style="margin:4px 0 0">
                            @order.OrderDate.ToString("dd/MM/yyyy")
                            @if (order.PickupDate != DateTime.MinValue)
                            {
                                <span> — Retrait : @order.PickupDate.ToString("dd/MM/yyyy HH:mm")</span>
                            }
                        </p>
                    </div>
                    <span class="badge @(order.Status.ToString() == "Honored" ? "badge-honnored" : order.Status.ToString() == "Ready" ? "badge-ready" : "badge-pending")">
                        @order.Status
                    </span>
                </div>
            }
        }

    </div>

</div>
