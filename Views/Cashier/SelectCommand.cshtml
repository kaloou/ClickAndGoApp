@model ClickAndGoApp.ViewModels.CashierOrderViewModel
@{
    ViewData["Title"] = "Select Command";
    ViewData["NavbarType"] = "Staff";
    ViewData["HideFooter"] = true;
}

<div class="content">

    <a asp-controller="Cashier" asp-action="Index" class="btn-back">← Back to Today's Orders</a>

    <div class="order-info-card">
        <h2>Order #@Model.Order.OrderId</h2>
        <div class="order-info-grid">
            <div>
                <span class="label">Customer ID</span>
                <span>@Model.Order.CustomerId</span>
            </div>
            <div>
                <span class="label">Pickup Time</span>
                <span>@Model.Order.PickupDate.ToString("HH:mm")</span>
            </div>
            <div>
                <span class="label">Status</span>
                <span class="badge badge-@Model.Order.Status.ToString().ToLower()">
                    @Model.Order.Status
                </span>
            </div>
            <div>
                <span class="label">Number of Boxes</span>
                <span>@Model.Order.NumberOfBoxes</span>
            </div>
            <div>
                <span class="label">Returned Boxes</span>
                <span>@Model.Order.ReturnedBoxes</span>
            </div>
            <div>
                <span class="label">Total Amount</span>
                <span class="total-amount">
                    @Model.TotalAmount.ToString("0.00") €
                </span>
            </div>
        </div>
    </div>

    <div class="encode-boxes-card">
        <h3>Enter Number of Returned Boxes</h3>
        <form method="post" asp-controller="Cashier" asp-action="EnterReturnedBoxes">
            <input type="hidden" name="orderId" value="@Model.Order.OrderId"/>
            <div class="form-group">
                <label for="returnedBoxes">Number of returned boxes</label>
                <input type="number" id="returnedBoxes" name="returnedBoxes"
                       min="0" value="@Model.Order.ReturnedBoxes" required/>
            </div>
            @if (ViewBag.Error != null)
            {
                <div class="error">@ViewBag.Error</div>
            }
            @if (ViewBag.Success != null)
            {
                <div class="success">@ViewBag.Success</div>
            }
            <button type="submit">Save</button>
        </form>
    </div>

    <div class="encode-boxes-card">
        <h3>Mark Order as Collected</h3>
        <p class="subtitle">Once the customer has collected their order, mark it as honored.</p>
        <form method="post" asp-controller="Cashier" asp-action="MarkAsCollected">
            <input type="hidden" name="orderId" value="@Model.Order.OrderId"/>
            <button type="submit" class="btn-danger">
                Mark as Collected
            </button>
        </form>
    </div>

</div>
