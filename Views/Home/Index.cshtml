@{
    ViewData["Title"] = "Accueil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HERO -->
<section class="hero-section">
    <div class="hero-text">
        <h1>Cliquez, commandez<br/>et retirez vos courses en magasin !</h1>
        <p>
            Composez votre panier en ligne, choisissez votre créneau de retrait<br/>
            et récupérez vos courses directement en magasin — sans file d'attente.<br/>
            Frais de service : <strong>5,95&nbsp;€</strong> par commande.
        </p>
        <a asp-controller="Product" asp-action="BrowseProducts" class="btn-cta">Faire vos courses</a>
    </div>
    <div class="hero-visual">
       <img src="images/panier.png" alt="panier"/>
    </div>
</section>

<!-- POINTS FORTS -->
<section class="features-section">
    <div class="feature-card">
        <h3>Commandez en ligne</h3>
        <p>Sélectionnez vos produits depuis chez vous, à tout moment.</p>
    </div>
    <div class="feature-card">
        <h3>Retrait rapide</h3>
        <p>Choisissez votre créneau et récupérez vos courses sans attendre.</p>
    </div>
    <div class="feature-card">
        <h3>Frais de service</h3>
        <p>Seulement 5,95&nbsp;€ par commande, sans frais de livraison supplémentaires.</p>
    </div>
</section>

<!-- STORE + RECETTES -->
<section class="split-section">
    <div class="store-block">
        <h2>Préparez-vous<br/>à gagner du temps</h2>
        <form method="get" asp-controller="Store" asp-action="Find">
            <div class="search-wrap">
                <input type="text" name="location" placeholder="Code postal, ville ..." />
                <button type="submit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398l3.85 3.85a1 1 0 0 0 1.415-1.415l-3.868-3.833zm-5.242 1.156a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z"/>
                    </svg>
                </button>
            </div>
        </form>
        <div id="store-map"></div>
    </div>
    <div class="recipes-block">
        <h3>Découvrez nos pack de recettes<br/>déjà préparé pour vous !</h3>
        <div class="recipes-row">
            <a asp-controller="Recipe" asp-action="SelectRecipe" asp-route-recipeId="1" class="recipe-thumb">
                <img src="/images/recipes/pasta_bolognese.jpg" alt="Pâtes bolognaise" />
                <span class="recipe-thumb-name">Pâtes bolognaise</span>
            </a>
            <a asp-controller="Recipe" asp-action="SelectRecipe" asp-route-recipeId="2" class="recipe-thumb">
                <img src="/images/recipes/chicken_curry_with_rice.jpg" alt="Curry de poulet au riz" />
                <span class="recipe-thumb-name">Curry de poulet au riz</span>
            </a>
            <a asp-controller="Recipe" asp-action="SelectRecipe" asp-route-recipeId="3" class="recipe-thumb">
                <img src="/images/recipes/caesar_salad.jpg" alt="Salade César" />
                <span class="recipe-thumb-name">Salade César</span>
            </a>
            <a asp-controller="Recipe" asp-action="SelectRecipe" asp-route-recipeId="4" class="recipe-thumb">
                <img src="/images/recipes/banana_almond_smoothie.webp" alt="Smoothie banane-amande" />
                <span class="recipe-thumb-name">Smoothie banane-amande</span>
            </a>
        </div>
        <div class="recipes-voir-plus">
            <a asp-controller="Recipe" asp-action="Index" class="btn-cta">Voir plus</a>
        </div>
    </div>
</section>

<!-- APP -->
<section class="app-section">
    <div class="app-text">
        <h2>Click &amp; Go dans votre poche !</h2>
        <p>
            Commandez vos courses où que vous soyez, à n'importe quelle heure.<br/>
            Suivez l'état de votre commande en temps réel et recevez une notification<br/>
            dès que votre panier est prêt à être retiré.
        </p>
        <a href="#" class="btn-cta">Installer l'app</a>
    </div>
    <div class="app-visual">
        <div class="phone-mock"></div>
    </div>
</section>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('store-map').setView([50.4108, 4.4444], 12);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        var stores = [
            { name: "Click & Go Jumet",      address: "Chaussée de Bruxelles 167, 6040 Jumet",     lat: 50.4421, lng: 4.4181 },
            { name: "Click & Go Gosselies",  address: "Rue de la Motte 4, 6041 Gosselies",         lat: 50.4641, lng: 4.4349 },
            { name: "Click & Go Marcinelle", address: "Rue de Philippeville 256, 6001 Marcinelle", lat: 50.3971, lng: 4.4321 },
            { name: "Click & Go Gilly",      address: "Rue de Ransart 80, 6060 Gilly",             lat: 50.4211, lng: 4.4731 }
        ];

        stores.forEach(function(s) {
            L.marker([s.lat, s.lng])
             .addTo(map)
             .bindPopup('<strong>' + s.name + '</strong><br/>' + s.address);
        });
    </script>
}
