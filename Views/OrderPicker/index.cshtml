@model List<ClickAndGoApp.Models.Order>
@{
    ViewData["Title"] = "Orders to Prepare";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Orders to Prepare</title>
    <link rel="stylesheet" href="~/css/style.css"/>
</head>
<body>

<div class="dashboard">

    <!-- NAVBAR -->
    <nav class="navbar">
        <h1>Click & Collect</h1>
        <div class="navbar-right">
            <span>Welcome, @Context.Session.GetString("firstName")</span>
            <a href="/Auth/Logout">Logout</a>
        </div>
    </nav>

    <!-- CONTENT -->
    <div class="content">
        <h2>Orders to Prepare for Tomorrow</h2>

        @if (ViewBag.Message != null)
        {
            <div class="empty-message">@ViewBag.Message</div>
        }
        else
        {
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer ID</th>
                        <th>Pickup Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.OrderId</td>
                            <td>@order.CustomerId</td>
                            <td>@order.PickupDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="badge badge-@order.Status.ToString().ToLower()">
                                    @order.Status
                                </span>
                            </td>
                            <td>
                                <a href="/OrderPicker/OrderDetails/@order.OrderId" 
                                   class="btn-primary">
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

</body>
</html>