@model List<ClickAndGoApp.Models.Order>
@{
    ViewData["Title"] = "Orders to Prepare";
    ViewData["NavbarType"] = "Staff";
    ViewData["HideFooter"] = true;
}

<div class="content">
    <h2>Orders to Prepare for Tomorrow</h2>

    @if (ViewBag.Message != null)
    {
        <div class="empty-message">@ViewBag.Message</div>
    }
    else
    {
        <table class="orders-table">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer ID</th>
                    <th>Pickup Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.OrderId</td>
                        <td>@order.CustomerId</td>
                        <td>@order.PickupDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <span class="badge badge-@order.Status.ToString().ToLower()">
                                @order.Status
                            </span>
                        </td>
                        <td>
                            <a asp-controller="OrderPicker" asp-action="OrderDetails"
                               asp-route-id="@order.OrderId"
                               class="btn-primary">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
