@model ClickAndGoApp.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Mon panier";
}

<div class="browse-page">

    <div class="browse-header">
        <h1>Mon panier</h1>
    </div>

    @if (Model.Order == null || !Model.OrderLines.Any())
    {
        <div class="no-results">Votre panier est vide. <a asp-controller="Product" asp-action="BrowseProducts">Parcourir les produits</a></div>
    }
    else
    {
        <div class="cart-layout">

            @* -- Colonne gauche : articles -- *@
            <div class="section-card cart-items-col">
                @foreach (var line in Model.OrderLines)
                {
                    <div class="cart-item">

                        <div class="cart-item-img">
                            @if (line.Product.ImagePath != null)
                            {
                                <img src="@line.Product.ImagePath" alt="@line.Product.Name"/>
                            }
                            else
                            {
                                <i data-lucide="shopping-basket"></i>
                            }
                        </div>

                        <div class="cart-item-info">
                            <p class="product-detail-category">@line.Product.Category.Name</p>
                            <p class="cart-item-name">@line.Product.Name</p>
                            <p class="cart-item-price">@line.Product.Price.ToString("F2") €</p>
                        </div>

                        <form asp-action="UpdateQuantity" method="post" class="cart-qty-form">
                            <input type="hidden" name="productId" value="@line.Product.ProductId"/>
                            <input type="number" name="quantity" value="@line.Quantity" class="cart-qty-input"/>
                            <button type="submit" class="btn-cta-sm">Appliquer</button>
                        </form>

                        <form asp-action="RemoveProduct" method="post">
                            <input type="hidden" name="productId" value="@line.Product.ProductId"/>
                            <button type="submit" class="btn-remove" title="Retirer">
                                <i data-lucide="trash-2"></i>
                            </button>
                        </form>

                    </div>
                }
            </div>

            @* -- Colonne droite : récapitulatif -- *@
            <div class="cart-summary-card">
                <h2 class="cart-summary-title">Récapitulatif</h2>

                <div class="cart-summary-line">
                    <span>Sous-total</span>
                    <span>@Model.ProductsTotal.ToString("F2") €</span>
                </div>
                <div class="cart-summary-line">
                    <span>Frais de service</span>
                    <span>+ 5,95 €</span>
                </div>

                <div class="cart-summary-divider"></div>

                <div class="cart-summary-total">
                    <span>Total</span>
                    <span class="cart-total-amount">@Model.Total.ToString("F2") €</span>
                </div>

                <a asp-controller="Order" asp-action="Index" class="btn-cta cart-summary-btn">Passer commande</a>
            </div>

        </div>
    }

</div>
