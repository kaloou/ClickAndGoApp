@model ClickAndGoApp.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Mon panier";
}

<div class="browse-page">

    <div class="browse-header">
        <h1>Mon panier</h1>
    </div>

    @if (Model.Order == null || !Model.OrderLines.Any())
    {
        <div class="no-results">Votre panier est vide. <a asp-controller="Product" asp-action="BrowseProducts">Parcourir les produits</a></div>
    }
    else
    {
        <div class="section-card">

            @foreach (var line in Model.OrderLines)
            {
                <div class="cart-item">

                    <div class="product-detail-img cart-item-img">
                        @if (line.Product.ImagePath != null)
                        {
                            <img src="@line.Product.ImagePath" alt="@line.Product.Name"/>
                        }
                        else
                        {
                            <span>🛒</span>
                        }
                    </div>

                    <div class="cart-item-info">
                        <p class="product-detail-category">@line.Product.Category.Name</p>
                        <p class="cart-item-name">@line.Product.Name</p>
                        <p class="cart-item-price">@line.Product.Price.ToString("F2") €</p>
                    </div>

                    @* UpdateQuantity *@
                    <form asp-action="UpdateQuantity" method="post" class="cart-qty-form">
                        <input type="hidden" name="productId" value="@line.Product.ProductId"/>
                        <input type="number" name="quantity" value="@line.Quantity" min="1" class="cart-qty-input"/>
                        <button type="submit" class="btn-cta-sm">Appliquer</button>
                    </form>

                    @* RemoveProduct *@
                    <form asp-action="RemoveProduct" method="post">
                        <input type="hidden" name="productId" value="@line.Product.ProductId"/>
                        <button type="submit" class="btn-remove" title="Retirer">✕</button>
                    </form>

                </div>
            }

            <div class="cart-footer">
                <div class="price-summary">
                    <p class="price-summary-label">Sous-total</p>
                    <p class="price-summary-amount">@Model.ProductsTotal.ToString("F2") €</p>
                </div>
                <div class="price-summary">
                    <p class="price-summary-label">Total (frais inclus)</p>
                    <p class="product-detail-price">@Model.Total.ToString("F2") €</p>
                </div>
                <a asp-controller="Order" asp-action="Index" class="btn-cta">Passer commande</a>
            </div>

        </div>
    }

</div>
