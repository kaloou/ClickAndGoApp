<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Click & Go</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true"/>
</head>
<body>

<header class="site-header">
    <nav class="site-nav">

        @* logo et nom du site *@
        <a asp-controller="Home" asp-action="Index" class="nav-brand">
            <div class="nav-logo">
                <img src="~/images/logo.png" alt="Logo Click & Go"/>
            </div>
            <span class="nav-name">Click & Go</span>
        </a>

        @* barre de recherche vers Product/BrowseProducts *@
        <form method="get" asp-controller="Product" asp-action="BrowseProducts" class="nav-search">
            <input type="text" name="q" placeholder="Cherchez des produits ou des recettes" class="nav-search-input" />
            <button type="submit" class="nav-search-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398l3.85 3.85a1 1 0 0 0 1.415-1.415l-3.868-3.833zm-5.242 1.156a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z"/>
                </svg>
            </button>
        </form>

        @* icônes de navigation droite *@
        <div class="nav-actions">

            @* menu hamburger *@
            <button class="nav-icon-btn" aria-label="Menu">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
                </svg>
            </button>

            @* bouton connexion / profil *@
            @if (Context.Session.GetString("role") == "Customer")
            {
                <a asp-controller="Customer" asp-action="Profile" class="nav-icon-btn" aria-label="Mon compte">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.029 10 8 10c-2.029 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                    </svg>
                </a>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Login" class="nav-icon-btn" aria-label="Se connecter">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.029 10 8 10c-2.029 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                    </svg>
                </a>
            }

            @* bouton panier *@
            <a asp-controller="Cart" asp-action="Index" class="nav-icon-btn nav-cart" aria-label="Panier">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l1.313 7h8.17l1.313-7H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM5 13a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                </svg>
                <span class="cart-dot"></span>
            </a>

        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

@* Notif notifications *@
@{
    var toastSuccess = TempData["Success"] as string;
    var toastError   = TempData["Error"]   as string;
}
@if (toastSuccess != null || toastError != null)
{
    <div class="notif-wrapper">
        @if (toastSuccess != null)
        {
            <div class="notif notif-success">
                <span class="notif-icon">✓</span>
                <span>@toastSuccess</span>
                <button class="notif-close" onclick="this.parentElement.remove()">✕</button>
            </div>
        }
        @if (toastError != null)
        {
            <div class="notif notif-error">
                <span class="notif-icon">✕</span>
                <span>@toastError</span>
                <button class="notif-close" onclick="this.parentElement.remove()">✕</button>
            </div>
        }
    </div>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    document.querySelectorAll('.notif').forEach(function(n) {
        setTimeout(function() {
            n.style.animation = 'notif-out 0.3s ease forwards';
            setTimeout(function() { n.remove(); }, 300);
        }, 4000);
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
