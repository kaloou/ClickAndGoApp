<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Click & Go</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true"/>
    @await RenderSectionAsync("HeadLinks", required: false)
</head>
<body>

<header class="site-header">
    <nav class="site-nav">

        @* logo et nom du site *@
        <a asp-controller="Home" asp-action="Index" class="nav-brand">
            <div class="nav-logo">
                <img src="~/images/logo.png" alt="Logo Click & Go"/>
            </div>
            <span class="nav-name">Click & Go</span>
        </a>

        @* liens de navigation centre *@
        <nav class="nav-links">
            <a asp-controller="Product" asp-action="BrowseProducts" class="nav-link-item">Produits</a>
            <a asp-controller="Recipe"  asp-action="Index"           class="nav-link-item">Recettes</a>
        </nav>

        @* icônes de navigation droite *@
        <div class="nav-actions">

            @* menu hamburger *@
            @* hamburger *@
            <button class="nav-icon-btn" aria-label="Menu">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="4" y1="7"  x2="20" y2="7"/>
                    <line x1="4" y1="12" x2="20" y2="12"/>
                    <line x1="4" y1="17" x2="20" y2="17"/>
                </svg>
            </button>

            @* bouton connexion / profil *@
            @if (Context.Session.GetString("role") == "Customer")
            {
                <a asp-controller="Customer" asp-action="Profile" class="nav-icon-btn nav-profile" aria-label="Mon compte">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="4"/>
                        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                    </svg>
                    <span class="nav-username">@Context.Session.GetString("firstName")</span>
                </a>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Login" class="nav-icon-btn" aria-label="Se connecter">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="4"/>
                        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                    </svg>
                </a>
            }

            @* bouton panier *@
            <a asp-controller="Cart" asp-action="Index" class="nav-icon-btn nav-cart" aria-label="Panier">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9"  cy="21" r="1"/>
                    <circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
                <span class="cart-dot"></span>
            </a>

        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="site-footer">
    <div class="footer-inner">

        <div class="footer-brand">
            <img src="~/images/logo.png" alt="Click & Go" class="footer-logo" />
            <span class="footer-name">Click &amp; Go</span>
            <p class="footer-tagline">Commandez en ligne,<br/>retirez en magasin.</p>
        </div>

        <div class="footer-col">
            <h4 class="footer-heading">Navigation</h4>
            <a asp-controller="Product" asp-action="BrowseProducts" class="footer-link">Produits</a>
            <a asp-controller="Recipe"  asp-action="Index"           class="footer-link">Recettes</a>
            <a asp-controller="Cart"    asp-action="Index"           class="footer-link">Mon panier</a>
        </div>

        <div class="footer-col">
            <h4 class="footer-heading">Nos magasins</h4>
            <p class="footer-text">Click &amp; Go Jumet</p>
            <p class="footer-text">Click &amp; Go Gosselies</p>
            <p class="footer-text">Click &amp; Go Marcinelle</p>
            <p class="footer-text">Click &amp; Go Gilly</p>
        </div>

        <div class="footer-col">
            <h4 class="footer-heading">Infos</h4>
            <p class="footer-text">Frais de service&nbsp;: 5,95&nbsp;€</p>
            <p class="footer-text">Retrait gratuit en magasin</p>
            <p class="footer-text">Lun – Sam&nbsp;: 8h – 20h</p>
        </div>

    </div>
    <div class="footer-bottom">
        <span>© 2026 Click &amp; Go — Tous droits réservés</span>
    </div>
</footer>

@* Notif notifications *@
@{
    var toastSuccess = TempData["Success"] as string;
    var toastError   = TempData["Error"]   as string;
}
@if (toastSuccess != null || toastError != null)
{
    <div class="notif-wrapper">
        @if (toastSuccess != null)
        {
            <div class="notif notif-success">
                <span class="notif-icon">✓</span>
                <span>@toastSuccess</span>
                <button class="notif-close" onclick="this.parentElement.remove()">✕</button>
            </div>
        }
        @if (toastError != null)
        {
            <div class="notif notif-error">
                <span class="notif-icon">✕</span>
                <span>@toastError</span>
                <button class="notif-close" onclick="this.parentElement.remove()">✕</button>
            </div>
        }
    </div>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    document.querySelectorAll('.notif').forEach(function(n) {
        setTimeout(function() {
            n.style.animation = 'notif-out 0.3s ease forwards';
            setTimeout(function() { n.remove(); }, 300);
        }, 4000);
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
