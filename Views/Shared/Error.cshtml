@{
    ViewData["Title"] = "Erreur";
}

<h1 style="color: var(--cg-error-fg)">Erreur.</h1>
<h2 style="color: var(--cg-error-fg)">Une erreur est survenue lors du traitement de votre requête.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Mode développement</h3>
<p>
    Passer en environnement <strong>Development</strong> affichera plus de détails sur l'erreur.
</p>
<p>
    <strong>L'environnement Development ne doit pas être activé en production.</strong>
    Il peut exposer des informations sensibles aux utilisateurs.
    Pour déboguer en local, définissez la variable d'environnement <strong>ASPNETCORE_ENVIRONMENT</strong>
    à <strong>Development</strong> et redémarrez l'application.
</p>
