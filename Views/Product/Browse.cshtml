@model ClickAndGoApp.Models.BrowseViewModel
@{
    ViewData["Title"] = "Nos produits";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="browse-page">
    
    <div class="browse-header">
        <h1>Nos produits</h1>
        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery)) // recherche par nom
        {
            <p class="browse-subtitle">
                Résultats pour <strong>« @Model.SearchQuery »</strong> — @Model.Products.Count produit(s) trouvé(s)
            </p>
        }
        else
        {
            <p class="browse-subtitle">@Model.Products.Count produit(s) disponible(s)</p>
        }
    </div>
    
    <div class="category-filters">
        <a href="@Url.Action("Browse", "Product", new { q = Model.SearchQuery })"
           class="filter-pill @(Model.SelectedCategoryId == null ? "active" : "")">
            Tous
        </a>
        @foreach (var cat in Model.Categories)
        {
            <a href="@Url.Action("Browse", "Product", new { q = Model.SearchQuery, categoryId = cat.CategoryId })"
               class="filter-pill @(Model.SelectedCategoryId == cat.CategoryId ? "active" : "")">
                @cat.Name
            </a>
        }
    </div>
    
    <div class="products-grid">
        @if (Model.Products.Count == 0)
        {
            <div class="no-results">
                <p>Aucun produit trouvé.</p>
            </div>
        }
        else
        {
            @foreach (var product in Model.Products)
            {
                var catName = Model.Categories.FirstOrDefault(c => c.CategoryId == product.CategoryId)?.Name ?? "";
                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId" class="product-card">
                    <div class="product-img">
                        @if (!string.IsNullOrEmpty(product.ImagePath))
                        {
                            <img src="~/images/@product.ImagePath" alt="@product.Name"/>
                        }
                        else
                        {
                            <span> pas de photo</span>
                        }
                    </div>
                    <div class="product-info">
                        <div class="product-category">@catName</div>
                        <div class="product-name">@product.Name</div>
                        <div class="product-price">@product.Price.ToString("0.00") €</div>
                    </div>
                </a>
            }
        }
    </div>

</div>
