@model List<ClickAndGoApp.Models.TimeSlot>
@{
    ViewData["Title"] = "Choisir un créneau";
    string storeName = ViewBag.StoreName as string;
}

<div class="browse-page">

    <div class="browse-header">
        <a asp-action="SelectStore" class="detail-back">← Changer de magasin</a>
        <h1>Choisir un créneau</h1>
        <p class="browse-subtitle">Créneaux disponibles pour <strong>@storeName</strong></p>
    </div>

    @if (!Model.Any())
    {
        <div class="timeslot-empty">
            <i data-lucide="calendar-x"></i>
            <p class="timeslot-empty-title">Aucun créneau disponible</p>
            <p class="timeslot-empty-sub">Ce magasin n'a pas de créneaux pour le moment.</p>
            <a asp-action="SelectStore" class="btn-cta">Choisir un autre magasin</a>
        </div>
    }
    else
    {
        <div class="timeslot-grid">
            @foreach (var slot in Model)
            {
                <div class="timeslot-card">
                    <div class="timeslot-card-date">
                        <i data-lucide="calendar"></i>
                        <span>@slot.StartTime.ToString("dddd dd MMMM yyyy")</span>
                    </div>
                    <div class="timeslot-card-time">
                        <i data-lucide="clock"></i>
                        <span>@slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")</span>
                    </div>
                    <form asp-action="SelectTimeSlot" method="post">
                        <input type="hidden" name="timeSlotId" value="@slot.TimeSlotId"/>
                        <button type="submit" class="btn-cta timeslot-card-btn">Choisir ce créneau</button>
                    </form>
                </div>
            }
        </div>
    }

</div>
