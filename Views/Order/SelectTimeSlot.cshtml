@model List<ClickAndGoApp.Models.TimeSlot>
@{
    ViewData["Title"] = "Choisir un créneau";
    string storeName = ViewBag.StoreName as string;
}

<div class="browse-page">

    <div class="browse-header">
        <h1>Choisir un créneau</h1>
        <p class="browse-subtitle">Créneaux disponibles pour @storeName</p>
    </div>

    @if (!Model.Any())
    {
        <div class="no-results">
            Aucun créneau disponible pour ce magasin.
            <a asp-action="SelectStore">Choisir un autre magasin</a>
        </div>
    }
    else
    {
        <div class="section-card">
            @foreach (var slot in Model)
            {
                <form asp-action="SelectTimeSlot" method="post">
                    <input type="hidden" name="timeSlotId" value="@slot.TimeSlotId"/>
                    <button type="submit" class="timeslot-btn">
                        <div>
                            <p class="timeslot-title">@slot.StartTime.ToString("dddd dd MMMM yyyy")</p>
                            <p class="timeslot-meta">@slot.StartTime.ToString("HH:mm") – @slot.EndTime.ToString("HH:mm")</p>
                        </div>
                        <span class="btn-cta-sm">Choisir</span>
                    </button>
                </form>
            }
        </div>
    }

    <div class="page-nav">
        <a asp-action="SelectStore" class="nav-back">← Changer de magasin</a>
        <a asp-action="Index" class="nav-back">← Retour au récapitulatif</a>
    </div>

</div>
